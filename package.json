  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.19.1",
    "@wdio/cli": "^9.14.0",
    "@wdio/local-runner": "^9.14.0",
    "@wdio/mocha-framework": "^9.14.0",
    "@wdio/spec-reporter": "^9.14.0",
    "allure-commandline": "^2.34.1",
    "chai": "^5.2.0",
    "chromedriver": "^138.0.5",
    "mocha": "^11.2.2",
    "prettier": "^3.6.2",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.5.0"
  }
