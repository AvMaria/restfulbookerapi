{
  "name": "restfulbookerapitestig",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx wdio run wdio.conf.js",
    "test:api": "npx wdio run wdio.conf.js --suite api",
    "test:ui": "npx wdio run wdio.conf.js --suite ui",
    "test:api:file": "npx wdio run wdio.conf.js --spec",
    "wdio": "wdio run ./wdio.conf.js",
    "format": "prettier --write .",
    "allure:generate": "allure generate reports/allure-results",
    "allure:open": "allure open reports/allure",
    "docker:up": "docker compose up --build --abort-on-container-exit --exit-code-from tests",
    "docker:down": "docker compose down -v",
    "docker:test": "npm run docker:up && npm run docker:down"
  },
  "keywords": [],
